{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "Generator": {
    "BatchSize": 10,
    "TotalPatients": 100,
    "DelayBetweenBatchesMs": 2000,
    "RandomDelay": true,
    "MinDelayMs": 1000,
    "MaxDelayMs": 3000,
    "IncludeDomainProperties": false
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5051",
        "Protocols": "Http2"
      }
    }
  }
}