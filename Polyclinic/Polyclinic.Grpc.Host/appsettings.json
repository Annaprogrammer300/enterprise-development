{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7002",
        "Protocols": "Http2"
      },
      "Http": {
        "Url": "http://localhost:5002",
        "Protocols": "Http2"
      }
    }
  },
  "Generator": {
    "BatchSize": 5,
    "WaitTimeSeconds": 12,
    "GenerationTimeoutMinutes": 1,
    "InitialDelaySeconds": 5
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=PolyclinicDb;Username=postgres;Password=123456"
  }
}